{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/gst", "destination": "/gst-services", "permanent": true },
    { "source": "/export-business-kaise-shuru-kare", "destination": "/how-to-start-export-business-in-india-step-by-step", "permanent": true },
    { "source": "/iec-code-kaise-banaye", "destination": "/iec-code-registration-guide-india", "permanent": true },
    { "source": "/gst-lut-kya-hai", "destination": "/gst-lut-filing-guide", "permanent": true },
    { "source": "/rcmc-kya-hai", "destination": "/rcmc-registration-guide-india", "permanent": true },
    { "source": "/export-buyer-kaise-dhunde", "destination": "/finding-verified-buyers-for-export-business", "permanent": true },
    { "source": "/fake-export-buyer-se-kaise-bache", "destination": "/how-to-identify-fake-export-buyers-and-avoid-scams", "permanent": true },
    { "source": "/fob-cif-price-kaise-nikale", "destination": "/export-pricing-how-to-calculate-fob-and-cif-price", "permanent": true },
    { "source": "/export-documents-list-hindi", "destination": "/export-documents-checklist-india", "permanent": true },
    { "source": "/incoterms-hindi", "destination": "/incoterms-2020-explained-for-indian-exporters", "permanent": true },
    { "source": "/letter-of-credit-kya-hai", "destination": "/letter-of-credit-documentation-guide", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "buygenixsolution.vercel.app" }],
      "destination": "https://www.buygenixsolutions.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/company/:slug", "destination": "/api/company?slug=:slug" },
    { "source": "/sitemap-companies.xml", "destination": "/api/sitemap-companies" },
    { "source": "/export-demand-report", "destination": "/api/buyers?path=export-demand-report" },
    { "source": "/buyers", "destination": "/api/buyers" },
    { "source": "/buyers/:a/:b/:c", "destination": "/api/buyers?path=:a/:b/:c" },
    { "source": "/buyers/:a/:b", "destination": "/api/buyers?path=:a/:b" },
    { "source": "/buyers/:a", "destination": "/api/buyers?path=:a" },
    { "source": "/sitemap-buyers.xml", "destination": "/api/sitemap-buyers" },
    { "source": "/admin", "destination": "/admin-portal" },
    { "source": "/portal", "destination": "/client-portal" }
  ]
}
